    password: "YOUR_PASSWORD"
  
  development:
    base_url: "https://your-dev-instance.successfactors.com"
    company_id: "YOUR_COMPANY_ID"
    username: "YOUR_USERNAME"
    password: "YOUR_PASSWORD"

