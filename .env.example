# ─────────────────────────────────────────────────────────────────────────────
# sf_object_sync — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Source (PRD) environment ──────────────────────────────────────────────────
SF_SOURCE_URL=https://<prd-host>/odata/v2
SF_SOURCE_USER=api_user@company.com
SF_SOURCE_PASSWORD=your_prd_password_here

# ── Target (Dev) environment ──────────────────────────────────────────────────
SF_TARGET_URL=https://<dev-host>/odata/v2
SF_TARGET_USER=api_user@company.com
SF_TARGET_PASSWORD=your_dev_password_here

# ── Authentication method ─────────────────────────────────────────────────────
# Options: basic | oauth | certificate
AUTH_METHOD=basic

# ── OAuth settings (required only when AUTH_METHOD=oauth) ─────────────────────
# SF_SOURCE_CLIENT_ID=your_source_client_id
# SF_SOURCE_CLIENT_SECRET=your_source_client_secret
# SF_SOURCE_TOKEN_URL=https://<prd-host>/oauth/token
# SF_TARGET_CLIENT_ID=your_target_client_id
# SF_TARGET_CLIENT_SECRET=your_target_client_secret
# SF_TARGET_TOKEN_URL=https://<dev-host>/oauth/token

# ── Certificate settings (required only when AUTH_METHOD=certificate) ─────────
# SF_SOURCE_CERT_PATH=credentials/source_cert.pem
# SF_SOURCE_KEY_PATH=credentials/source_key.pem
# SF_TARGET_CERT_PATH=credentials/target_cert.pem
# SF_TARGET_KEY_PATH=credentials/target_key.pem

# ── Optional overrides ────────────────────────────────────────────────────────
# DRY_RUN=true
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT_SEC=30
# OUTPUT_DIR=./output
